## 📄 `controllers/gpsController.js`

```javascript
const GPS = require('../models/GPS');
const LoggingService = require('../services/LoggingService');
const socket = require('../socket/socketHandler');

module.exports = {
    updateGPS: async (req, res) => {
        try {
            const gpsData = await GPS.store(req.body);

            socket.broadcastGPS(gpsData);

            LoggingService.logGPS(gpsData.unitId, gpsData);

            res.json({ message: "GPS updated.", gpsData });
        } catch (error) {
            res.status(500).json({ error: error.message });
        }
    },

    getUnitGPS: async (req, res) => {
        const gpsData = await GPS.getLatest(req.params.id);
        res.json(gpsData);
    }
};
```

