## 📄 `middleware/noTowPolicy.js` — NO‑TOW Enforcement

```javascript
module.exports = (req, res, next) => {
    const forbiddenWords = ['tow', 'winch', 'wrecker', 'towyard'];

    const payload = JSON.stringify(req.body).toLowerCase();
    const url = req.originalUrl.toLowerCase();

    if (forbiddenWords.some(word => payload.includes(word) || url.includes(word))) {
        return res.status(403).json({
            error: "WE DO NOT PROVIDE TOW SERVICE OR WINCHING SERVICE."
        });
    }

    next();
};
