## 📄 `components/DispatchFeed.js`

```javascript
import React, { useEffect, useState } from 'react';
import socket from '../socket/socket';

export default function DispatchFeed() {
    const [breakdowns, setBreakdowns] = useState([]);

    useEffect(() => {
        socket.on('breakdown_update', (data) => {
            setBreakdowns(prev => [...prev, data]);
        });
    }, []);

    return (
        <div>
            <h2>Breakdown Feed</h2>
            {breakdowns.map((b, i) => (
                <div key={i}>
                    <strong>{b.unitId}</strong> — {b.status}
                </div>
            ))}
        </div>
    );
}
```

