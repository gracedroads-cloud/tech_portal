const socketIO = require('socket.io');

let io;

module.exports = (server) => {
    io = socketIO(server, {
        cors: { origin: "*" }
    });

    io.on('connection', (socket) => {
        console.log("Client connected:", socket.id);
    });
};

module.exports.broadcastGPS = (gpsData) => {
    io.emit('gps_update', gpsData);
};

module.exports.broadcastBreakdown = (breakdown) => {
    io.emit('breakdown_update', breakdown);
};

module.exports.broadcastProtocolStep = (step) => {
    io.emit('protocol_step', step);
};
```

