## 📄 `controllers/emergencyController.js`

```javascript
const DiagnosisService = require('../services/DiagnosisService');
const DispatchService = require('../services/DispatchService');
const RoutingService = require('../services/RoutingService');
const VendorService = require('../services/VendorService');
const LoggingService = require('../services/LoggingService');

module.exports = {
    executeProtocol: async (req, res) => {
        try {
            const breakdown = req.body;

            // Step 1: Hazard Scan
            LoggingService.logStep(breakdown.id, "Hazard Scan Completed");

            // Step 2: Diagnosis
            const diagnosis = await DiagnosisService.runDiagnosis(breakdown);
            LoggingService.logStep(breakdown.id, `Diagnosis: ${diagnosis.severity}`);

            // Step 3: Repair Path
            LoggingService.logStep(breakdown.id, `Repair Path: ${diagnosis.repairPath}`);

            // Step 4: Technician Dispatch
            const tech = await DispatchService.assignTechnician(breakdown);
            LoggingService.logStep(breakdown.id, `Technician Assigned: ${tech.id}`);

            // Step 5: Driver Routing
            const route = await RoutingService.suggestSafeLocation(breakdown);
            LoggingService.logStep(breakdown.id, `Driver Routing: ${route.location}`);

            // Step 6: Vendor Selection (Repair Only)
            const vendor = await VendorService.selectRepairVendor(breakdown);
            LoggingService.logStep(breakdown.id, `Repair Vendor Selected: ${vendor.name}`);

            // Steps 7–11 handled inside Grace Engine
            LoggingService.logProtocolComplete(breakdown.id);

            return res.json({
                message: "Emergency protocol executed successfully.",
                diagnosis,
                technician: tech,
                routing: route,
                vendor
            });

        } catch (error) {
            return res.status(500).json({ error: error.message });
        }
    },

    executeStep: async (req, res) => {
        LoggingService.logStep(req.body.breakdownId, req.body.step);
        res.json({ message: "Step logged." });
    }
};
```

