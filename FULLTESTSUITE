# 📄 **noTowPolicy.test.js**

```javascript
const noTowPolicy = require('../../middleware/noTowPolicy');

describe("NO-TOW Policy Middleware", () => {

    test("Blocks tow-related payloads", () => {
        const req = {
            body: { action: "tow truck" },
            originalUrl: "/api/emergency/tow"
        };

        const res = {
            status: jest.fn().mockReturnThis(),
            json: jest.fn()
        };

        noTowPolicy(req, res, () => {});

        expect(res.status).toHaveBeenCalledWith(403);
        expect(res.json).toHaveBeenCalledWith({
            error: "WE DO NOT PROVIDE TOW SERVICE OR WINCHING SERVICE."
        });
    });

    test("Allows repair-only payloads", () => {
        const req = {
            body: { action: "repair" },
            originalUrl: "/api/emergency/execute"
        };

        const res = {
            status: jest.fn().mockReturnThis(),
            json: jest.fn()
        };

        const next = jest.fn();

        noTowPolicy(req, res, next);

        expect(next).toHaveBeenCalled();
    });

});
```

