# 📄 **breakdown.test.js**

```javascript
const { api } = require('../testUtils');

describe("Breakdowns API", () => {

    test("Create breakdown", async () => {
        const res = await api.post('/api/breakdowns').send({
            unitId: "T680-554",
            driverId: "DRV-882",
            faultCodes: ["P0420"],
            location: { lat: 40.1, lon: -75.1 }
        });

        expect(res.status).toBe(200);
        expect(res.body.status).toBe("New");
        expect(res.body.unitId).toBe("T680-554");
    });

    test("Get breakdown by ID", async () => {
        const create = await api.post('/api/breakdowns').send({
            unitId: "T680-554",
            driverId: "DRV-882"
        });

        const id = create.body.id;

        const res = await api.get(`/api/breakdowns/${id}`);

        expect(res.status).toBe(200);
        expect(res.body.unitId).toBe("T680-554");
    });

});
```

