# 📄 **Breakdown Schema (Ultra‑Detailed)**

```javascript
// /src/backend/models/Breakdown.js

const mongoose = require('mongoose');

const BreakdownSchema = new mongoose.Schema({
    unitId: { type: String, required: true },
    driverId: { type: String, required: true },
    technicianId: { type: String, default: null },

    status: {
        type: String,
        enum: ["New", "In Progress", "Completed"],
        default: "New"
    },

    faultCodes: { type: [String], default: [] },

    location: {
        lat: Number,
        lon: Number
    },

    severity: {
        type: String,
        enum: ["Critical", "High", "Medium", "Low"],
        default: "Medium"
    },

    repairPath: {
        type: String,
        enum: ["Electrical", "Mechanical", "Hydraulic", "Brake", "Suspension", "Trailer", "Unknown"],
        default: "Unknown"
    },

    timestamps: {
        createdAt: { type: Date, default: Date.now },
        updatedAt: { type: Date, default: Date.now }
    }
});

module.exports = mongoose.model("Breakdown", BreakdownSchema);
```

---

# 📄 **Unit Schema (Tractors, Trailers, Technicians, Drivers)**

```javascript
// /src/backend/models/Unit.js

const mongoose = require('mongoose');

const UnitSchema = new mongoose.Schema({
    unitId: { type: String, required: true, unique: true },
    type: {
        type: String,
        enum: ["tractor", "trailer", "technician", "driver"],
        required: true
    },

    name: String,
    phone: String,

    status: {
        type: String,
        enum: ["Active", "Inactive", "Repairing", "Unavailable"],
        default: "Active"
    },

    lastKnownLocation: {
        lat: Number,
        lon: Number,
        timestamp: Number
    },

    metadata: {}
});

module.exports = mongoose.model("Unit", UnitSchema);
```

---

# 📄 **GPS Schema (Ultra‑Detailed)**

```javascript
// /src/backend/models/GPS.js

const mongoose = require('mongoose');

const GPSSchema = new mongoose.Schema({
    unitId: { type: String, required: true },
    type: {
        type: String,
        enum: ["tractor", "trailer", "technician", "driver"],
        required: true
    },

    lat: Number,
    lon: Number,
    speed: Number,
    heading: Number,
    timestamp: Number
});

GPSSchema.statics.store = async function (data) {
    return await this.create(data);
};

GPSSchema.statics.getLatest = async function (unitId) {
    return await this.findOne({ unitId }).sort({ timestamp: -1 });
};

module.exports = mongoose.model("GPS", GPSSchema);
```

---

# 📄 **Log Schema (Emergency Protocol + System Logs)**

```javascript
// /src/backend/models/Log.js

const mongoose = require('mongoose');

const LogSchema = new mongoose.Schema({
    breakdownId: { type: String, required: true },
    step: String,
    details: {},
    timestamp: { type: Date, default: Date.now }
});

module.exports = mongoose.model("Log", LogSchema);
```

---

# 📄 **Vendor Schema (Repair‑Only Vendors)**

```javascript
// /src/backend/models/Vendor.js

const mongoose = require('mongoose');

const VendorSchema = new mongoose.Schema({
    name: { type: String, required: true },
    phone: String,
    region: String,

    type: {
        type: String,
        enum: ["repair"], // NO TOWING ALLOWED
        default: "repair"
    },

    services: [String],
    availability: {
        afterHours: Boolean,
        weekends: Boolean
    }
});

module.exports = mongoose.model("Vendor", VendorSchema);
```

---

# 📄 **System Health Schema**

```javascript
// /src/backend/models/SystemHealth.js

const mongoose = require('mongoose');

const SystemHealthSchema = new mongoose.Schema({
    backendStatus: String,
    socketStatus: String,
    gpsStatus: String,
    graceStatus: String,
    lastUpdated: { type: Date, default: Date.now }
});

module.exports = mongoose.model("SystemHealth", SystemHealthSchema);
```

---

# 📄 **Protocol History Schema (Full 11‑Step Tracking)**

```javascript
// /src/backend/models/ProtocolHistory.js

const mongoose = require('mongoose');

const ProtocolHistorySchema = new mongoose.Schema({
    breakdownId: { type: String, required: true },

    steps: [
        {
            stepNumber: Number,
            stepName: String,
            timestamp: { type: Date, default: Date.now },
            metadata: {}
        }
    ],

    completed: { type: Boolean, default: false }
});

module.exports = mongoose.model("ProtocolHistory", ProtocolHistorySchema);
```

