```

---

### 4.2 Frontend Dockerfile

Claude will create `/src/frontend/Dockerfile`:

```dockerfile
FROM node:18-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

RUN npm run build

EXPOSE 3001

CMD ["npx", "serve", "-s", "build", "-l", "3001"]
```

---

### 4.3 Docker Compose (Full System)

Claude will create `docker-compose.yml`:

```yaml
version: "3.9"

services:
  backend:
    build: ./src/backend
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=production
      - MONGO_URI=${MONGO_URI}
      - FRONTEND_URL=http://localhost:3001
    depends_on:
      - mongo

  frontend:
    build: ./src/frontend
    ports:
      - "3001:3001"

  mongo:
    image: mongo:6
    ports:
      - "27017:27017"
    volumes:
      - mongo-data:/data/db

volumes:
  mongo-data:
```

