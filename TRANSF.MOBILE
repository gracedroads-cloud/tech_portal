## 📄 `/screens/BreakdownIntakeScreen.js`

```javascript
import React, { useState } from 'react';
import { View, Text, TextInput, Button } from 'react-native';
import { createBreakdown } from '../api/breakdowns';

export default function BreakdownIntakeScreen({ navigation }) {
  const [unitId, setUnitId] = useState("");
  const [driverId, setDriverId] = useState("");
  const [faultCodes, setFaultCodes] = useState("");

  const submit = async () => {
    await createBreakdown({
      unitId,
      driverId,
      faultCodes: faultCodes.split(",")
    });

    navigation.navigate("EmergencyProtocol");
  };

  return (
    <View style={{ padding: 20 }}>
      <Text style={{ fontSize: 22 }}>Breakdown Intake</Text>

      <TextInput placeholder="Unit ID" value={unitId} onChangeText={setUnitId} style={{ borderWidth: 1, padding: 10, marginBottom: 10 }} />
      <TextInput placeholder="Driver ID" value={driverId} onChangeText={setDriverId} style={{ borderWidth: 1, padding: 10, marginBottom: 10 }} />
      <TextInput placeholder="Fault Codes (comma separated)" value={faultCodes} onChangeText={setFaultCodes} style={{ borderWidth: 1, padding: 10, marginBottom: 10 }} />

      <Button title="Submit Breakdown" onPress={submit} />
    </View>
  );
}
```

