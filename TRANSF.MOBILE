# ⭐ SECTION 4 — Hooks

---

## 📄 `/hooks/useBreakdowns.js`

```javascript
import { useState, useEffect } from 'react';
import socket from '../socket/socket';

export default function useBreakdowns() {
  const [breakdowns, setBreakdowns] = useState([]);

  useEffect(() => {
    socket.on('breakdown_update', (data) => {
      setBreakdowns(prev => [...prev, data]);
    });
  }, []);

  return breakdowns;
}
```

---

## 📄 `/hooks/useGpsUnit.js`

```javascript
import { useState, useEffect } from 'react';
import socket from '../socket/socket';

export default function useGpsUnit(unitId) {
  const [gps, setGps] = useState(null);

  useEffect(() => {
    socket.on('gps_update', (data) => {
      if (data.unitId === unitId) setGps(data);
    });
  }, [unitId]);

  return gps;
}
```

