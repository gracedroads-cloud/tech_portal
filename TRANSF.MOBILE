## 📄 `/screens/GpsMapScreen.js`

```javascript
import React from 'react';
import { View, Dimensions } from 'react-native';
import MapView, { Marker } from 'react-native-maps';
import useGpsUnit from '../hooks/useGpsUnit';

export default function GpsMapScreen() {
  const gps = useGpsUnit("T680-554");

  return (
    <View>
      <MapView
        style={{ width: Dimensions.get("window").width, height: Dimensions.get("window").height }}
        initialRegion={{
          latitude: gps?.lat || 40.0,
          longitude: gps?.lon || -75.0,
          latitudeDelta: 0.05,
          longitudeDelta: 0.05
        }}
      >
        {gps && (
          <Marker
            coordinate={{ latitude: gps.lat, longitude: gps.lon }}
            title={gps.unitId}
            description={`Speed: ${gps.speed}`}
          />
        )}
      </MapView>
    </View>
  );
}
```

---

## 📄 `/screens/EmergencyProtocolScreen.js`

```javascript
import React, { useState, useEffect } from 'react';
import { View, Text, Button } from 'react-native';
import socket from '../socket/socket';
import NoTowBanner from '../components/NoTowBanner';
import { executeProtocol } from '../api/emergency';

export default function EmergencyProtocolScreen() {
  const [steps, setSteps] = useState([]);

  useEffect(() => {
    socket.on('protocol_step', (step) => {
      setSteps(prev => [...prev, step]);
    });
  }, []);

  const runProtocol = async () => {
    await executeProtocol({
      id: "BRK-001",
      unitId: "T680-554",
      driverId: "DRV-882",
      faultCodes: ["P0420"]
    });
  };

  return (
    <View style={{ padding: 20 }}>
      <NoTowBanner />

      <Text style={{ fontSize: 22 }}>Emergency Protocol</Text>

      <Button title="Run Protocol" onPress={runProtocol} />

      {steps.map((s, i) => (
        <Text key={i} style={{ marginTop: 10 }}>{s.step}</Text>
      ))}
    </View>
  );
}
```

