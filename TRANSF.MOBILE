# ⭐ SECTION 1 — App Entry  
### `/mobile/App.js`

```javascript
import React from 'react';
import { NavigationContainer } from '@react-navigation/native';
import { createNativeStackNavigator } from '@react-navigation/native-stack';

import LoginScreen from './src/screens/LoginScreen';
import DashboardScreen from './src/screens/DashboardScreen';
import BreakdownIntakeScreen from './src/screens/BreakdownIntakeScreen';
import TechnicianStatusScreen from './src/screens/TechnicianStatusScreen';
import GpsMapScreen from './src/screens/GpsMapScreen';
import EmergencyProtocolScreen from './src/screens/EmergencyProtocolScreen';

const Stack = createNativeStackNavigator();

export default function App() {
  return (
    <NavigationContainer>
      <Stack.Navigator initialRouteName="Login">
        <Stack.Screen name="Login" component={LoginScreen} />
        <Stack.Screen name="Dashboard" component={DashboardScreen} />
        <Stack.Screen name="BreakdownIntake" component={BreakdownIntakeScreen} />
        <Stack.Screen name="TechnicianStatus" component={TechnicianStatusScreen} />
        <Stack.Screen name="GpsMap" component={GpsMapScreen} />
        <Stack.Screen name="EmergencyProtocol" component={EmergencyProtocolScreen} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}
```

